{
  "manifest_version": 3,
  "name": "艦これ 終了予定通知",
  "version": "0.9.3",
  "version_name": "0.9.3RC",
  "description": "ゲームから読み取った観測情報と送信状況を表示し、中央サーバーへ送信します。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "options_page": "settings.html",
  "action": {
    "default_title": "艦これ 終了予定通知",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
